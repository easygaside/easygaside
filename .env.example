# ─────────────────────────────────────────────────────────────
# easygas — environment variables
# Copy this file to .env (or .env.local) and fill in real values.
# Anything WITHOUT the NEXT_PUBLIC_ prefix is server-only — never expose it.
# ─────────────────────────────────────────────────────────────

# ── Supabase (login/identity + data) ──
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key      # server-only — reads encrypted token columns

# ── Custom Google OAuth (separate from Supabase Auth) ──
# GCP console → APIs & Services → Credentials → OAuth 2.0 Client ID (type: Web application)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=                          # server-only
# Must EXACTLY match an "Authorized redirect URI" on the OAuth client.
# This is OUR callback — NOT the Supabase .../auth/v1/callback.
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# ── Token encryption (AES-256-GCM) ──
# Generate one with:  npm run keygen   (prints a base64 32-byte key)
APP_ENCRYPTION_KEY=

# ── Anthropic (used from Phase 2 onward — not required for the Phase 0 spike) ──
ANTHROPIC_API_KEY=
# Model ids are hardcoded in lib/anthropic-agent.ts:
#   default codegen = claude-sonnet-4-6   |   architect/plan = claude-opus-4-8

# ── Telegram (free) — pings you when a user submits a problem report (optional) ──
# 1) Message @BotFather → /newbot → copy the token below.
# 2) Message your new bot once, then open
#    https://api.telegram.org/bot<TOKEN>/getUpdates and copy result[].message.chat.id
#    (or add the bot to a group/channel and use that chat id).
# Leave both blank to just store reports in the DB (egs_reports) without notifications.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
