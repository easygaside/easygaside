# ─────────────────────────────────────────────────────────────
# easygas — environment variables
# Copy this file to .env (or .env.local) and fill in real values.
# Anything WITHOUT the NEXT_PUBLIC_ prefix is server-only — never expose it.
# ─────────────────────────────────────────────────────────────

# ── Supabase (login/identity + data) ──
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key      # server-only — reads encrypted token columns
# Optional: a non-public copy of the URL for server-only clients (falls back to NEXT_PUBLIC_ above).
SUPABASE_URL=

# ── Custom Google OAuth (separate from Supabase Auth) ──
# GCP console → APIs & Services → Credentials → OAuth 2.0 Client ID (type: Web application)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=                          # server-only
# Must EXACTLY match an "Authorized redirect URI" on the OAuth client.
# This is OUR callback — NOT the Supabase .../auth/v1/callback.
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# ── Token encryption (AES-256-GCM) ──
# Generate one with:  npm run keygen   (prints a base64 32-byte key)
APP_ENCRYPTION_KEY=

# ── LLM providers (A/B experiment: claude default, optional chatgpt / deepseek) ──
ANTHROPIC_API_KEY=
# Claude model ids are hardcoded in lib/anthropic-agent.ts (codegen = claude-sonnet-4-6).
# ChatGPT (OpenAI) — only needed if you assign testers to the 'chatgpt' arm:
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
# DeepSeek (OpenAI-compatible) — only needed for the 'deepseek' arm:
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
# Gemini (OpenAI-compatible endpoint) — only needed for the 'gemini' arm:
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ── Superadmin (/admin panel: assign provider arms + view experiment metrics) ──
SUPERADMIN_EMAILS=kpcrmv4@gmail.com

# ── Closed beta + per-user daily cap ──
# BETA_MODE=off  → open to everyone (no allowlist). Anything else (or unset) = closed beta:
#   only emails in the egs_beta_allowlist table can use it (BYOK users always pass).
#   Add testers with:  insert into egs_beta_allowlist (email) values ('them@gmail.com');
BETA_MODE=
# Generations/day per user on the PLATFORM key (BYOK users are uncapped). Default 30.
EASYGAS_DAILY_LIMIT=30

# ── Telegram (free) — pings you when a user submits a problem report (optional) ──
# 1) Message @BotFather → /newbot → copy the token below.
# 2) Message your new bot once, then open
#    https://api.telegram.org/bot<TOKEN>/getUpdates and copy result[].message.chat.id
#    (or add the bot to a group/channel and use that chat id).
# Leave both blank to just store reports in the DB (egs_reports) without notifications.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
